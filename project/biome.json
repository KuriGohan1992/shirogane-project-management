{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/.next",
			"!!**/node_modules",
			"!!**/out",
			"!!**/build",
			"!!**/.vercel"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}