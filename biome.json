{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"includes": [
			"**",
			"!!**/.next",
			"!!**/node_modules",
			"!!**/out",
			"!!**/build",
			"!!**/dist",
			"!!**/.vercel"
		]
	},

	"overrides": [
		{
			"includes": ["public/illustrations/**/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		}
	],

	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
