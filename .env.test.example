# Dedicated test database used by Vitest database tests and Playwright.
# Never point this at development or production data.
TEST_DATABASE_URL=postgresql://username:password@test-host/test-database?sslmode=require

# Required safety switch for destructive database integration tests.
ALLOW_TEST_DATABASE_RESET=true

# Clerk development instance keys used by the app and Playwright.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Existing user in the same Clerk development instance.
E2E_CLERK_USER_EMAIL=playwright@example.com