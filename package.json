		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^0.454.0",
		"next": "^16.0.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.6.7",
		"react": "^19",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^2.5.5",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
